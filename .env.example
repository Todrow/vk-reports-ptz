# Ключ доступа сообщества из VK: Управление -> Работа с API -> Ключи доступа.
VK_GROUP_TOKEN=vk1.a.example

# Числовой VK ID главного администратора, который подтверждает руководителей бюро.
SUPERADMIN_VK_ID=123456789

# Europe/Moscow, рабочие дни: 1=понедельник ... 7=воскресенье.
TIMEZONE=Europe/Moscow
WORKDAYS=1,2,3,4,5
REPORT_TIME=08:29

# Для теста true: свежий Excel уходит начальнику после каждой отметки.
# В боевом режиме можно поставить false, тогда отчёт приходит только по расписанию.
SEND_AFTER_EACH_MARK=true

# Необязательно. Если оставить пустым, бот определит ID сообщества по ключу.
VK_GROUP_ID=
